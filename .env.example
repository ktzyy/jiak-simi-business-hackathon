# Safe for browser use. Copy this file to .env.local and fill in values from
# the separate Jiak Simi hackathon/staging Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://mikpepfrumtglwweolzq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used in confirmation emails. Set this to the deployed staging URL in hosting.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Never put these in NEXT_PUBLIC_ variables.
OPENAI_API_KEY=
SUPABASE_SECRET_KEY=
# Demo setup writes these locally; staff API calls use the signed-in JWT.
DEMO_RESTAURANT_ID=
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=

# Telegram pilot: bot credentials and private chat allowlist are server-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_RESTAURANT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=

# Never add a Supabase secret key, service-role key, database password, or
# personal access token to a NEXT_PUBLIC_ variable.
