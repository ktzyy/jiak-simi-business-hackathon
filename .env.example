# Safe for browser use. Copy this file to .env.local and fill in values from
# the separate Jiak Simi hackathon/staging Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never add a Supabase secret key, service-role key, database password, or
# personal access token to a NEXT_PUBLIC_ variable.
